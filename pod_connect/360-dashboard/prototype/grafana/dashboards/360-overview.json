    {
      "id": 16,
      "type": "timeseries",
      "title": "Claims per hour: received vs adjudicated vs paid",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "pg360"
      },
      "gridPos": {
        "x": 0,
