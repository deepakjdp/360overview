  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "L1  Executive 360: domain health (worst application in each domain)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Domain health",
      "description": "Worst effective status of any application in the domain. IMPACTED = an upstream application is DOWN.",
      "datasource": {
        "type": "postgres",
        "uid": "pg360"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg360"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT domain AS \"Domain\", MAX(status_code) AS \"Status\" FROM v_app_status GROUP BY domain ORDER BY domain"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "HEALTHY",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "DEGRADED",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "IMPACTED",
                  "color": "orange",
                  "index": 2
                },
                "3": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 3,
      "type": "text",
      "title": "How to read this",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**HEALTHY** all applications up  \n**DEGRADED** slow or erroring  \n**IMPACTED** an upstream system is DOWN, so this one cannot work correctly  \n**DOWN** not responding\n\nSample data only. In the demo, `claims-adjudication` is DOWN, so Capitation, Contact and payments show IMPACTED."
      }
    },
    {
