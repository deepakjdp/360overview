            "uid": "pg360"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(received_at,'1h'), count(*) AS received FROM claims WHERE $__timeFilter(received_at) GROUP BY 1 ORDER BY 1"
