    {
      "id": 14,
      "type": "stat",
      "title": "Adjudicated within 4h (SLA 95%)",
      "description": "Only claims older than 4h are measured, so open claims do not distort the SLA.",
      "datasource": {
        "type": "postgres",
        "uid": "pg360"
      },
      "gridPos": {
        "x": 16,
        "y": 30,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg360"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE adjudicated_at - received_at <= interval '4 hours') / NULLIF(count(*),0), 1) AS value FROM claims WHERE $__timeFilter(received_at) AND received_at < now() - interval '4 hours'"
