    {
      "id": 5,
      "type": "table",
      "title": "Application status",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "pg360"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg360"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT app_name AS \"Application\", domain AS \"Domain\", tier AS \"Tier\", owner_team AS \"Owner\", status_code AS \"Status\", latency_ms AS \"Latency (ms)\", error_rate_pct AS \"Error %\", pod_restarts AS \"Restarts\", checked_at AS \"Last check\" FROM v_app_status ORDER BY status_code DESC, tier, app_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
