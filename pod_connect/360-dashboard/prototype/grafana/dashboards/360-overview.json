    {
      "id": 6,
      "type": "nodeGraph",
      "title": "Dependency map (upstream -> downstream)",
      "description": "Arrows point from upstream to downstream. Colour = effective status.",
      "datasource": {
        "type": "postgres",
        "uid": "pg360"
      },
      "gridPos": {
        "x": 14,
        "y": 7,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg360"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT app_id AS id, app_name AS title, domain AS \"subTitle\", status AS \"mainStat\", CASE status_code WHEN 0 THEN '#73BF69' WHEN 1 THEN '#FADE2A' WHEN 2 THEN '#FF9830' ELSE '#F2495C' END AS color FROM v_app_status"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "postgres",
            "uid": "pg360"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT from_app_id || '>' || to_app_id AS id, from_app_id AS source, to_app_id AS target, interface_type AS \"mainStat\" FROM dependencies"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Flow hops with status of both ends",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "pg360"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg360"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT u.app_name AS \"Upstream\", u.status_code AS \"Upstream status\", d.interface_type AS \"Interface\", n.app_name AS \"Downstream\", n.status_code AS \"Downstream status\", d.criticality AS \"Criticality\" FROM dependencies d JOIN v_app_status u ON u.app_id = d.from_app_id JOIN v_app_status n ON n.app_id = d.to_app_id ORDER BY GREATEST(u.status_code, n.status_code) DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
